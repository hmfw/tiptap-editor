{
  "name": "@mario9/tiptap-editor",
  "version": "1.0.1",
  "description": "基于 Tiptap + Vue 3 的富文本编辑器组件。",
  "type": "module",
  "main": "./dist/tiptap-editor.umd.cjs",
  "module": "./dist/tiptap-editor.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tiptap-editor.js",
      "require": "./dist/tiptap-editor.umd.cjs"
    },
    "./tiptap-editor.css": "./dist/tiptap-editor.css"
  },
  "types": "./dist/index.d.ts",
  "keywords": [
    "vue",
    "vue3",
    "tiptap",
    "editor",
    "rich-text",
    "wysiwyg",
    "富文本编辑器",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmfw/tiptap-editor.git"
  },
  "homepage": "https://github.com/hmfw/tiptap-editor#readme",
  "bugs": {
    "url": "https://github.com/hmfw/tiptap-editor/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vue-tsc -b && vite build --mode lib",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-bubble-menu": "^3.22.5",
    "@tiptap/extension-code-block-lowlight": "^3.22.5",
    "@tiptap/extension-highlight": "^3.22.5",
    "@tiptap/extension-horizontal-rule": "^3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-list": "^3.22.5",
    "@tiptap/extension-mathematics": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-subscript": "^3.22.5",
    "@tiptap/extension-superscript": "^3.22.5",
    "@tiptap/extension-table": "^3.22.5",
    "@tiptap/extension-text-align": "^3.22.5",
    "@tiptap/extension-typography": "^3.22.5",
    "@tiptap/extensions": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@tiptap/vue-3": "^3.22.5",
    "element-plus": "^2.13.0",
    "katex": "^0.16.0",
    "lowlight": "^3.3.0",
    "vue": "^3.5.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitejs/plugin-vue-jsx": "^5.1.4",
    "@vue/tsconfig": "^0.8.1",
    "sass-embedded": "^1.97.3",
    "typescript": "~5.9.3",
    "unplugin-element-plus": "^0.11.2",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^3.1.5"
  }
}
