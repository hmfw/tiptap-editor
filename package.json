{
  "name": "@hmfw/tiptap-editor",
  "version": "1.2.0",
  "description": "基于 Tiptap + Vue 3 的富文本编辑器组件。",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./dist/tiptap-editor.umd.cjs",
  "module": "./dist/tiptap-editor.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tiptap-editor.js",
      "require": "./dist/tiptap-editor.umd.cjs"
    },
    "./tiptap-editor.css": "./dist/tiptap-editor.css"
  },
  "types": "./dist/index.d.ts",
  "keywords": [
    "vue",
    "vue3",
    "tiptap",
    "editor",
    "rich-text",
    "wysiwyg",
    "富文本编辑器",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmfw/tiptap-editor.git"
  },
  "homepage": "https://github.com/hmfw/tiptap-editor#readme",
  "bugs": {
    "url": "https://github.com/hmfw/tiptap-editor/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vue-tsc -b && vite build --mode lib",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.31.0",
    "@tiptap/extension-bubble-menu": "^3.31.0",
    "@tiptap/extension-code-block-lowlight": "^3.31.0",
    "@tiptap/extension-highlight": "^3.31.0",
    "@tiptap/extension-horizontal-rule": "^3.31.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-list": "^3.31.0",
    "@tiptap/extension-mathematics": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/extension-subscript": "^3.31.0",
    "@tiptap/extension-superscript": "^3.31.0",
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/extension-text-align": "^3.31.0",
    "@tiptap/extension-typography": "^3.31.0",
    "@tiptap/extensions": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@tiptap/vue-3": "^3.31.0",
    "katex": "^0.18.0",
    "lowlight": "^3.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.8.1",
    "playwright": "^1.63.0",
    "sass-embedded": "^1.105.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^3.3.11"
  }
}
